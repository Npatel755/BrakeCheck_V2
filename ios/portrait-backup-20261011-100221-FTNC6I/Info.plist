<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>BrakeCheck</string>
	<key>CFBundleShortVersionString</key>
	<string>0.4.0</string>
	<key>CFBundleVersion</key>
	<string>4</string>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>BrakeCheck uses the rear camera to detect vehicles and record a rolling dashcam buffer during a trip.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_brakecheck._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>BrakeCheck discovers and connects to your paired computer on your local network for voice alerts and emergency contact check-ins.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>BrakeCheck uses your iPhone's location speed to show your current speed and estimate the lead vehicle's speed. During an active trip, location updates may continue in the background until you end the trip.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>BrakeCheck records a short spoken reply after a possible impact, then sends it to your backend and ElevenLabs for transcription.</string>
	<key>NSMotionUsageDescription</key>
	<string>When enabled, BrakeCheck uses motion readings to mark possible impacts and preserve available dashcam footage.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>BrakeCheckMeasurementRevision</key>
	<string>N8</string>
	<key>BrakeCheckMeasurementFingerprint</key>
	<string>320afd87b236bad29d67e8f189a6838f8b28e577929af93afaa1e6da15b58b7f</string>
</dict>
