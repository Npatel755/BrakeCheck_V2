# Package manifests are hashed model assets; Windows checkout must not change them.
ios/Sources/BrakeCheck/Resources/DetectorModelData/**/Manifest.json text eol=lf
ios/Sources/BrakeCheck/Resources/LaneModelData/**/Manifest.json text eol=lf
*.sh text eol=lf
*.mlmodel -text
*.bin -text

model_candidates/**/Manifest.json text eol=lf
# Keep source files portable across the Windows checkout and WSL toolchain.
*.swift text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Preserve hashed model provenance exactly; its manifest records these bytes.
ios/Sources/BrakeCheck/Resources/LaneModelData/UFLDv2Lane-provenance.json -text
.gitattributes text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
.railwayignore text eol=lf
ios/Sources/BrakeCheck/Resources/LaneModelData/UFLDv2Lane.mlpackage/Data/com.apple.CoreML/weights/weight.bin filter=lfs diff=lfs merge=lfs -text
