# Paste into Railway's service Variables editor and replace every CHANGE_ME value.
# Generate two different keys with the command in README-RAILWAY.md.
BRAKECHECK_APP_KEY=CHANGE_ME_RANDOM_APP_KEY_AT_LEAST_24_CHARACTERS
AGENT_SHARED_KEY=CHANGE_ME_DIFFERENT_RANDOM_AGENT_KEY_AT_LEAST_24_CHARACTERS
SPECTRUM_PROJECT_ID=CHANGE_ME
SPECTRUM_PROJECT_SECRET=CHANGE_ME
ELEVENLABS_API_KEY=CHANGE_ME
DRIVER_NAME=CHANGE_ME
PORT=8000
PHOTON_AGENT_PORT=8787
BRAKECHECK_DISABLE_MDNS=1
CONTACTS_FILE=/data/contacts.json
PAIRED_DEVICES_FILE=/data/paired_devices.json
VOICE_CACHE_DIR=/data/voice_cache
