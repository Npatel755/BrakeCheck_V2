@echo off
setlocal
set "BC_OVERNIGHT_PROJECT=%~dp0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$project=$env:BC_OVERNIGHT_PROJECT; $pipeline=Join-Path $project 'tools\dataset_pipeline'; $data=Join-Path $project 'BrakeCheck_Dataset'; $python=Join-Path $pipeline '.venv\Scripts\python.exe'; $model=Join-Path $data 'experiments\flagged_teacher\run-20261020-234051'; $logs=Join-Path $data 'logs'; New-Item -ItemType Directory -Path $logs -Force | Out-Null; $existing=Get-CimInstance Win32_Process | Where-Object { $_.Name -match '^python' -and $_.CommandLine -match 'bcdata\.overnight_collections' }; if($existing){Write-Output 'The overnight queue is already running.'; exit 0}; $arguments='-u -m bcdata.overnight_collections --data-root '+[char]34+$data+[char]34+' --model-experiment '+[char]34+$model+[char]34+' --epochs 20'; if(Test-Path -LiteralPath (Join-Path $data 'experiments\overnight_collections\active.json')){$arguments+=' --resume'}; $worker=Start-Process -FilePath $python -ArgumentList $arguments -WorkingDirectory $pipeline -WindowStyle Hidden -PassThru -RedirectStandardOutput (Join-Path $logs 'overnight-collections.stdout.log') -RedirectStandardError (Join-Path $logs 'overnight-collections.stderr.log'); Write-Output ('Overnight queue launcher PID: '+$worker.Id); Write-Output 'Order: existing collection 2, then collection 3, then collection 4. Private provisional runs; no model is promoted.'"
if errorlevel 1 pause
